# ── Choose your LLM provider ──────────────────────────────────────────────────
# Options: groq | gemini | ollama | anthropic
# Default: groq (free, no credit card needed)
LLM_PROVIDER=groq

# ── Groq (FREE — recommended) ────────────────────────────────────────────────
# Sign up free at https://console.groq.com → API Keys → Create
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Google Gemini (FREE tier) ─────────────────────────────────────────────────
# Get key free at https://aistudio.google.com → Get API Key
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ── Ollama (LOCAL — 100% free, no internet needed) ────────────────────────────
# Install: https://ollama.com → then run: ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── Anthropic Claude (PAID — optional) ────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── FalkorDB ─────────────────────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
